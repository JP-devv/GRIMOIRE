B70_PLE_DIRECT_PINNED=1
B70_PLE_FP8=1
B70_PLE_FP8_NVME=1
B70_PLE_FP8_PATH=/models/qwen38-w4a16
B70_PLE_INT8=0
B70_PLE_INT8_NVME=0
B70_PLE_INT8_NVME_CACHE_GIB=8
B70_PLE_INT8_NVME_IO_THREADS=16
B70_PLE_INT8_NVME_READER=native
B70_MOE_HOTCOLD=0
B70_MOE_COLD_PREFETCH=0
B70_MOE_HOTCOLD_SWAP=0
B70_MOE_ROUTE_COUNT=0
B70_MOE_DECODE_OP=0
B70_MOE_CPU=0
B70_DEFAULT_PRESENCE_PENALTY=0
B70_DEFAULT_REPETITION_DETECTION=max=1,min=1,count=128
