+sycl::event launch_qfn_hc_pack_down(sycl::queue& q, const QuantWeight& w,
+                                    sycl_bf16* packed) {
+    if (w.fmt != Fmt::BF16 || w.K != 10240 || w.N != 320 || !w.payload || !packed)
+        throw std::invalid_argument("invalid QFN HC down weight for resident packing");
+    return dequant_vnni<Fmt::BF16>(q, w, packed, {}, w.N);
+}
+
+sycl::event launch_qfn_hc_down_packed(sycl::queue& q, const QuantWeight& w,
+                                      const sycl_bf16* packed, const sycl_bf16* x,
+                                      float* y, int rows, const std::vector<sycl::event>& deps) {
+    if (w.fmt != Fmt::BF16 || w.K != 10240 || w.N != 320 || !packed ||
+        !gemm_fast_shape_ok(w, rows))
+        throw std::invalid_argument("invalid QFN HC tiled packed operands");
+    return gemm_bf16_vnni<0, false, 64>(q, x, packed, y, rows, w.N, w.K, deps, w.N);
+}
