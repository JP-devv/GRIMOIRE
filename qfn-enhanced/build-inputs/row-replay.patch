+// Diagnostic target verifier only: replay the same prefix of candidate rows,
+// with independent prompt reconstruction before every sample.
+static int qfn_replay_rows(Grimoire& e, const std::vector<int32_t>& prompt) {
+    constexpr int anchor = 760;
+    const std::vector<int32_t> proposed{anchor, 1156, 16562, 16563};
+    if (prompt.size() != 2706 || e.prefix_cache_usable() || e.mtp4.ok)
+        throw std::runtime_error("QFN row replay requires the frozen prompt and MTP and prefix cache off");
+    auto reset_to_prompt = [&] {
+        GenerationOptions options;
+        options.max_tokens = 1;
+        FinishReason reason{};
+        std::vector<int32_t> first;
+        generate_tokens(e, prompt, options, first, {}, reason);
+        if (first != std::vector<int32_t>{anchor} || e.pos != int(prompt.size()))
+            throw std::runtime_error("QFN replay prompt state or anchor mismatch");
+        e.q.wait_and_throw();
+    };
+
+    reset_to_prompt();
+    std::vector<int32_t> expected;
+    for (int32_t token : proposed) {
+        if (!e.forward(token)) throw std::runtime_error("QFN target-only replay forward failed");
+        expected.push_back(e.argmax_token());
+    }
+    int sample = 0;
+    for (const size_t rows : {1u, 4u, 4u, 1u}) {
+        reset_to_prompt();
+        std::vector<int32_t> candidates(proposed.begin(), proposed.begin() + rows);
+        std::vector<int32_t> predicted;
+        const auto start = std::chrono::steady_clock::now();
+        if (!e.prefill_qwen4_exp(candidates, &predicted, nullptr))
+            throw std::runtime_error("QFN verifier declined row replay");
+        e.q.wait_and_throw();
+        const double ms = std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - start).count();
+        const bool match = predicted.size() == rows &&
+            std::equal(predicted.begin(), predicted.end(), expected.begin());
+        std::fprintf(stderr, "QFN row replay rank=%d sample=%d rows=%zu verify_ms=%.6f target_ids_match=%d\n",
+                     e.tp_rank, sample++, rows, ms, int(match));
+        if (!e.tp_agree_min(match) || !match)
+            throw std::runtime_error("QFN verifier predictions differ from target-only replay");
+    }
+    return 0;
+}
